jev_api_key=

# Required for web answers; optional for CLI evidence-only mode (GLM 5.3).
glm_key=

# Optional private Discord history collector. Bot token, never a user-account token.
discord_bot_token=

# AWS deployment or optional private S3 backup. Never commit populated credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
